static bool ReadImuFrame(ImuFrame* out) {
  if (out == nullptr) {
    return false;
  }

  uint8_t reg = 0x3B;
  uint8_t data[14];
  if (i2c_master_transmit_receive(s_mpu_handle, &reg, 1, data, 14, -1) != ESP_OK) {
    return false;
  }

  out->ax = static_cast<int16_t>((data[0] << 8) | data[1]) / ACCEL_SCALE;
  out->ay = static_cast<int16_t>((data[2] << 8) | data[3]) / ACCEL_SCALE;
  out->az = static_cast<int16_t>((data[4] << 8) | data[5]) / ACCEL_SCALE;
  out->gx = static_cast<int16_t>((data[8] << 8) | data[9]) / GYRO_SCALE;
  out->gy = static_cast<int16_t>((data[10] << 8) | data[11]) / GYRO_SCALE;
  out->gz = static_cast<int16_t>((data[12] << 8) | data[13]) / GYRO_SCALE;
  return true;
}

