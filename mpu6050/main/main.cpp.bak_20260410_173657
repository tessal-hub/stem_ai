#include <stdio.h>
#include <string.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_log.h"
#include "driver/i2c_master.h"

#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/micro/system_setup.h"
#include "tensorflow/lite/schema/schema_generated.h"

static const char *TAG = "GESTURE_6DOF";

// Cấu hình Pin I2C
#define I2C_MASTER_SCL_IO GPIO_NUM_9
#define I2C_MASTER_SDA_IO GPIO_NUM_8
#define MPU6050_ADDR 0x68

// Buffer 6 kênh
#define WINDOW_SIZE 50
#define CHANNELS 6
#define BUFFER_LENGTH (WINDOW_SIZE * CHANNELS)
float input_buffer[BUFFER_LENGTH] = {0};

// Tensor Arena — 60KB để đủ cho model + MUL op
const int kTensorArenaSize = 60 * 1024;
uint8_t tensor_arena[kTensorArenaSize];

// Model AI
alignas(8) extern const unsigned char g_model[];
extern const int g_model_len;

// Nhãn — khớp thứ tự train.py
const char *CLASSES[] = {
    "Vẽ vòng tròn (CIRCLE)",
    "Gọi điện (CALL)",
    "Chỉ tay (POINT)",
    "Nghỉ (IDLE)"};

i2c_master_dev_handle_t mpu6050_handle;

// Đọc đồng thời Gia tốc + Con quay hồi chuyển (14 bytes)
bool read_mpu6050_6dof(float *ax, float *ay, float *az,
                       float *gx, float *gy, float *gz)
{
    uint8_t reg_addr = 0x3B;
    uint8_t data[14];

    if (i2c_master_transmit_receive(mpu6050_handle,
                                    &reg_addr, 1,
                                    data, 14, -1) == ESP_OK)
    {
        // Gia tốc kế (Byte 0–5)
        *ax = (int16_t)((data[0] << 8) | data[1]) / 32768.0f;
        *ay = (int16_t)((data[2] << 8) | data[3]) / 32768.0f;
        *az = (int16_t)((data[4] << 8) | data[5]) / 32768.0f;
        // Byte 6–7: nhiệt độ, bỏ qua
        // Con quay hồi chuyển (Byte 8–13)
        *gx = (int16_t)((data[8] << 8) | data[9]) / 32768.0f;
        *gy = (int16_t)((data[10] << 8) | data[11]) / 32768.0f;
        *gz = (int16_t)((data[12] << 8) | data[13]) / 32768.0f;
        return true;
    }
    return false;
}

extern "C" void app_main(void)
{

    // =========================================
    // 1. KHỞI TẠO I2C & MPU6050
    // =========================================
    i2c_master_bus_config_t i2c_mst_config = {};
    i2c_mst_config.i2c_port = I2C_NUM_0;
    i2c_mst_config.sda_io_num = I2C_MASTER_SDA_IO;
    i2c_mst_config.scl_io_num = I2C_MASTER_SCL_IO;
    i2c_mst_config.clk_source = I2C_CLK_SRC_DEFAULT;
    i2c_mst_config.glitch_ignore_cnt = 7;
    i2c_mst_config.flags.enable_internal_pullup = true;

    i2c_master_bus_handle_t bus_handle;
    ESP_ERROR_CHECK(i2c_new_master_bus(&i2c_mst_config, &bus_handle));

    i2c_device_config_t dev_cfg = {};
    dev_cfg.dev_addr_length = I2C_ADDR_BIT_LEN_7;
    dev_cfg.device_address = MPU6050_ADDR;
    dev_cfg.scl_speed_hz = 400000;
    ESP_ERROR_CHECK(i2c_master_bus_add_device(bus_handle, &dev_cfg, &mpu6050_handle));

    // Wake up MPU6050
    uint8_t wake_cmd[] = {0x6B, 0x00};
    ESP_ERROR_CHECK(i2c_master_transmit(mpu6050_handle, wake_cmd, sizeof(wake_cmd), -1));

    // Bật bộ lọc nhiễu phần cứng DLPF
    uint8_t dlpf_cmd[] = {0x1A, 0x04};
    ESP_ERROR_CHECK(i2c_master_transmit(mpu6050_handle, dlpf_cmd, sizeof(dlpf_cmd), -1));

    ESP_LOGI(TAG, "Khởi tạo I2C & MPU6050 (6-DOF) hoàn tất!");

    // =========================================
    // 2. KHỞI TẠO TENSORFLOW LITE MICRO
    // =========================================
    tflite::InitializeTarget();
    const tflite::Model *model = tflite::GetModel(g_model);

    if (model->version() != TFLITE_SCHEMA_VERSION)
    {
        ESP_LOGE(TAG, "Model schema version không khớp!");
        return;
    }

    // Đăng ký đầy đủ các op — thêm AddMul() để fix lỗi 'MUL'
    // Tăng resolver lên <13>
    tflite::MicroMutableOpResolver<13> resolver;
    resolver.AddConv2D();
    resolver.AddDepthwiseConv2D();
    resolver.AddMaxPool2D();
    resolver.AddReshape();
    resolver.AddFullyConnected();
    resolver.AddExpandDims();
    resolver.AddSoftmax();
    resolver.AddShape();
    resolver.AddStridedSlice();
    resolver.AddPack();
    resolver.AddMul();
    resolver.AddQuantize();
    resolver.AddAdd(); // ← Fix lỗi "Didn't find op ADD"    // ← Cần cho INT8 quantized model

    tflite::MicroInterpreter interpreter(model, resolver,
                                         tensor_arena, kTensorArenaSize);

    if (interpreter.AllocateTensors() != kTfLiteOk)
    {
        ESP_LOGE(TAG, "Lỗi cấp phát Tensor Arena! Tăng kTensorArenaSize.");
        return;
    }

    // Log size thực tế đang dùng để tối ưu sau
    ESP_LOGI(TAG, "Tensor Arena thực tế dùng: %d / %d bytes",
             (int)interpreter.arena_used_bytes(), kTensorArenaSize);

    TfLiteTensor *input = interpreter.input(0);
    TfLiteTensor *output = interpreter.output(0);

    float input_scale = input->params.scale;
    int input_zero_point = input->params.zero_point;
    float output_scale = output->params.scale;
    int output_zero_point = output->params.zero_point;

    ESP_LOGI(TAG, "AI 6-DOF sẵn sàng! Bắt đầu lấy mẫu...");

    // =========================================
    // 3. VÒNG LẶP SUY LUẬN CHÍNH
    // =========================================
    float ax, ay, az, gx, gy, gz;
    int sample_count = 0;
    int cooldown = 0;

    while (1)
    {
        if (read_mpu6050_6dof(&ax, &ay, &az, &gx, &gy, &gz))
        {

            // Dịch buffer sang trái 6 vị trí (sliding window)
            memmove(input_buffer,
                    input_buffer + CHANNELS,
                    (BUFFER_LENGTH - CHANNELS) * sizeof(float));

            // Ghi 6 giá trị mới vào cuối
            input_buffer[BUFFER_LENGTH - 6] = ax;
            input_buffer[BUFFER_LENGTH - 5] = ay;
            input_buffer[BUFFER_LENGTH - 4] = az;
            input_buffer[BUFFER_LENGTH - 3] = gx;
            input_buffer[BUFFER_LENGTH - 2] = gy;
            input_buffer[BUFFER_LENGTH - 1] = gz;

            sample_count++;
            if (cooldown > 0)
                cooldown--;

            if (sample_count >= WINDOW_SIZE && cooldown == 0)
            {

                // Lượng tử hóa input sang INT8
                for (int i = 0; i < BUFFER_LENGTH; i++)
                {
                    int val = (int)(input_buffer[i] / input_scale + input_zero_point);
                    // Clamp về [-128, 127]
                    if (val > 127)
                        val = 127;
                    if (val < -128)
                        val = -128;
                    input->data.int8[i] = (int8_t)val;
                }

                if (interpreter.Invoke() != kTfLiteOk)
                {
                    ESP_LOGE(TAG, "Lỗi Invoke mạng Neural!");
                    continue;
                }

                float max_prob = 0.0f;
                int max_index = -1;

                for (int i = 0; i < 4; i++)
                {
                    float prob = (output->data.int8[i] - output_zero_point) * output_scale;
                    if (prob > max_prob)
                    {
                        max_prob = prob;
                        max_index = i;
                    }
                }

                // Bỏ qua IDLE (index = 3) và ngưỡng thấp
                if (max_prob > 0.85f && max_index != 3)
                {
                    ESP_LOGI(TAG, "=> CỬ CHỈ: %s (Độ tin cậy: %.1f%%)",
                             CLASSES[max_index], max_prob * 100.0f);
                    cooldown = 50;
                }
            }
        }

        vTaskDelay(pdMS_TO_TICKS(20)); // 50Hz
    }
}