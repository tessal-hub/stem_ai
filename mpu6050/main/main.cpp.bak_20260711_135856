    ESP_LOGE(TAG, "MPU6050 wake failed");
    return false;
  }

  uint8_t dlpf[] = {0x1A, 0x04};
  if (i2c_master_transmit(s_mpu_handle, dlpf, sizeof(dlpf), -1) != ESP_OK) {
    ESP_LOGE(TAG, "MPU6050 DLPF config failed");
    return false;
