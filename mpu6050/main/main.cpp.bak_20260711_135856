extern "C" void app_main(void) {
  if (!spellbook::InitializeSpellRuntime()) {
    ESP_LOGE("MAIN", "Runtime initialization failed");
    return;
  }

  ESP_LOGI("MAIN", "Starting inference loop");
  while (1) {
    spellbook::AppMainLoopStep();
    vTaskDelay(pdMS_TO_TICKS(STEM_INFERENCE_INTERVAL_MS));
  }
}
