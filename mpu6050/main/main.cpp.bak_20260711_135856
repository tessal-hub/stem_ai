static float s_max_energy = 0.0f;

static SpellId RunInference(const ImuFrame& frame) {
  if (s_input == nullptr || s_output == nullptr || s_interpreter == nullptr) {
    return SpellId::UNKNOWN;
  }

  memmove(s_input_buffer,
          s_input_buffer + CHANNELS,
          (BUFFER_LENGTH - CHANNELS) * sizeof(float));

  s_input_buffer[BUFFER_LENGTH - 6] = frame.ax;
  s_input_buffer[BUFFER_LENGTH - 5] = frame.ay;
  s_input_buffer[BUFFER_LENGTH - 4] = frame.az;
  s_input_buffer[BUFFER_LENGTH - 3] = frame.gx;
  s_input_buffer[BUFFER_LENGTH - 2] = frame.gy;
  s_input_buffer[BUFFER_LENGTH - 1] = frame.gz;

  if (s_sample_count < WINDOW_SIZE) {
    s_sample_count++;
    return SpellId::UNKNOWN;
  }

  // Tính phương sai 25 mẫu cuối (250ms) để nhận biết điểm dừng thật sự
  const int TAIL_LEN = 25;
  int start_idx = WINDOW_SIZE - TAIL_LEN;

  float sum_ax = 0, sum_ay = 0, sum_az = 0;
  float sum_gx = 0, sum_gy = 0, sum_gz = 0;
  for (int i = start_idx; i < WINDOW_SIZE; ++i) {
    sum_ax += s_input_buffer[i * CHANNELS + 0];
    sum_ay += s_input_buffer[i * CHANNELS + 1];
    sum_az += s_input_buffer[i * CHANNELS + 2];
    sum_gx += s_input_buffer[i * CHANNELS + 3];
    sum_gy += s_input_buffer[i * CHANNELS + 4];
    sum_gz += s_input_buffer[i * CHANNELS + 5];
  }
  float mean_ax = sum_ax / TAIL_LEN;
  float mean_ay = sum_ay / TAIL_LEN;
  float mean_az = sum_az / TAIL_LEN;
  float mean_gx = sum_gx / TAIL_LEN;
  float mean_gy = sum_gy / TAIL_LEN;
  float mean_gz = sum_gz / TAIL_LEN;

  float var_accel = 0;
  float var_gyro = 0;
  for (int i = start_idx; i < WINDOW_SIZE; ++i) {
    float dx = s_input_buffer[i * CHANNELS + 0] - mean_ax;
    float dy = s_input_buffer[i * CHANNELS + 1] - mean_ay;
    float dz = s_input_buffer[i * CHANNELS + 2] - mean_az;
    var_accel += (dx * dx + dy * dy + dz * dz);

    float dgx = s_input_buffer[i * CHANNELS + 3] - mean_gx;
    float dgy = s_input_buffer[i * CHANNELS + 4] - mean_gy;
    float dgz = s_input_buffer[i * CHANNELS + 5] - mean_gz;
    var_gyro += (dgx * dgx + dgy * dgy + dgz * dgz);
  }
  var_accel /= TAIL_LEN;
  var_gyro /= TAIL_LEN;

  // Kết hợp Accel và Gyro thành 1 biến đo năng lượng chuyển động.
  // Chia 10000.0f để scale gyro về cùng tầm quan trọng với accel.
  float motion_energy = var_accel + (var_gyro / 10000.0f);

  if (s_is_moving) {
    if (motion_energy < 0.02f) { // Hạ ngưỡng stop xuống 0.02 và tăng TAIL_LEN để không bị gãy gesture phức tạp
      s_is_moving = false;
      SpellId predicted = SpellId::UNKNOWN;
      if (s_best_class >= 0) {
        if (!g_preloaded_spells[s_best_class].is_spell) {
            printf("DEBUG_BLACKHOLE:%s (prob: %.2f)\n", g_preloaded_spells[s_best_class].name, s_best_prob);
        } else if (s_best_prob > 0.70f && s_best_class != kIdleClassIndex) {
            printf("FINAL PREDICT:%s:%.2f\n", SpellNameFromIndex(s_best_class), s_best_prob);
            predicted = SpellFromIndex(s_best_class);
        } else {
            printf("DEBUG_MISS:%s (prob: %.2f)\n", SpellNameFromIndex(s_best_class), s_best_prob);
        }
      }
      
      s_best_prob = 0.0f;
      s_best_class = -1;
      s_max_energy = 0.0f;

      // Flush buffer to prevent re-triggering on gesture tail
      for (int i = 0; i < WINDOW_SIZE; ++i) {
        s_input_buffer[i * CHANNELS + 0] = frame.ax;
        s_input_buffer[i * CHANNELS + 1] = frame.ay;
        s_input_buffer[i * CHANNELS + 2] = frame.az;
        s_input_buffer[i * CHANNELS + 3] = frame.gx;
        s_input_buffer[i * CHANNELS + 4] = frame.gy;
        s_input_buffer[i * CHANNELS + 5] = frame.gz;
      }
      return predicted;
    }
  } else {
    if (motion_energy > 0.10f) { // Nâng ngưỡng start lên 0.10 để tương xứng
      s_is_moving = true;
    } else {
      return SpellId::UNKNOWN;
    }
  }

  // Đọc số lượng frame model thực sự cần (để chống buffer overflow nếu pipeline train với window_size nhỏ hơn 64)
  int model_frames = s_input->dims->data[1];
  // Đọc số lượng channel từ model
  int model_channels = s_input->dims->data[2];
  
  const float in_scale = s_input->params.scale;
  const int in_zp = s_input->params.zero_point;
  
  // Chỉ lấy model_frames * 6 phần tử cuối cùng của s_input_buffer (vì buffer chỉ lưu 6 kênh raw)
  int start_offset = BUFFER_LENGTH - (model_frames * 6);
  if (start_offset < 0) start_offset = 0;

  for (int f = 0; f < model_frames; ++f) {
    int idx = start_offset + f * 6;
    float ax = (float)s_input_buffer[idx];
    float ay = (float)s_input_buffer[idx+1];
    float az = (float)s_input_buffer[idx+2];
    float gx = (float)s_input_buffer[idx+3];
    float gy = (float)s_input_buffer[idx+4];
    float gz = (float)s_input_buffer[idx+5];

    if (model_channels == 9) {
      float derived0 = az * gx;
      float derived1 = az * gy;
      float jerkz = 0.0f;
      if (idx >= 6) {
          jerkz = az - ((float)s_input_buffer[idx - 6 + 2]);
      }
      float in_vals[9] = {ax, ay, az, gx, gy, gz, derived0, derived1, jerkz};
      for(int c=0; c<9; c++) {
        int val = static_cast<int>(in_vals[c] / in_scale + in_zp);
        val = val > 127 ? 127 : val;
        val = val < -128 ? -128 : val;
        s_input->data.int8[f * 9 + c] = static_cast<int8_t>(val);
      }
    } else {
      // Tương thích ngược với model 6 kênh cũ
      float in_vals[6] = {ax, ay, az, gx, gy, gz};
      for(int c=0; c<6; c++) {
        int val = static_cast<int>(in_vals[c] / in_scale + in_zp);
        val = val > 127 ? 127 : val;
        val = val < -128 ? -128 : val;
        s_input->data.int8[f * 6 + c] = static_cast<int8_t>(val);
      }
    }
  }

  if (s_interpreter->Invoke() != kTfLiteOk) {
    ESP_LOGE(TAG, "Invoke failed");
    return SpellId::UNKNOWN;
  }

  const float out_scale = s_output->params.scale;
  const int out_zp = s_output->params.zero_point;
  
  // Extract 16-D embedding
  float current_embedding[16];
  for (int i = 0; i < 16; ++i) {
      current_embedding[i] = (s_output->data.int8[i] - out_zp) * out_scale;
  }

  float v_out[16];
  float norm_curr = 0.0f;
  for (int i = 0; i < 16; ++i) {
    v_out[i] = current_embedding[i];
    norm_curr += v_out[i] * v_out[i];
  }
  float inv_norm = 1.0f / (sqrt(norm_curr) + 1e-6f);
  for (int i = 0; i < 16; ++i) v_out[i] *= inv_norm;

  float max_cos = -1.0f;
  int max_idx = -1;
  for (int i = 0; i < g_preloaded_spell_count; ++i) {
    float cos_sim = 0.0f;
    for (int j = 0; j < 16; ++j) {
      cos_sim += v_out[j] * g_preloaded_spells[i].centroid[j];
    }
    if (cos_sim > max_cos) {
      max_cos = cos_sim;
      max_idx = i;
    }
  }

  // L1 Energy of the ENTIRE window (64 samples), same as Python _windowize
  float window_energy = 0.0f;
  for (int i = BUFFER_LENGTH - (WINDOW_SIZE * CHANNELS); i < BUFFER_LENGTH; ++i) {
    window_energy += (s_input_buffer[i] > 0) ? s_input_buffer[i] : -s_input_buffer[i];
  }

  if (max_idx >= 0) {
    // REJECT CLASS THRESHOLD
    if (max_cos < g_preloaded_spells[max_idx].threshold) {
      // Điểm embedding nằm quá xa mọi nguyên tử -> Unknown Gesture (OOD)
      // Không ghi nhận
    } else {
      if (window_energy > s_max_energy) {
        s_max_energy = window_energy;
        s_best_prob = max_cos;
        s_best_class = max_idx;
      }
    }
  }

  return SpellId::UNKNOWN;
}

