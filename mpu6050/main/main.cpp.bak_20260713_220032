static bool ReadImuFrame(ImuFrame* out) {
  if (out == nullptr) return false;
  uint8_t reg = 0x3B;
  uint8_t data[14];
  if (i2c_master_transmit_receive(s_mpu_handle, &reg, 1, data, 14, -1) != ESP_OK) {
    return false;
  }
  out->ax = static_cast<int16_t>((data[0] << 8) | data[1]) / ACCEL_SCALE;
  out->ay = static_cast<int16_t>((data[2] << 8) | data[3]) / ACCEL_SCALE;
  out->az = static_cast<int16_t>((data[4] << 8) | data[5]) / ACCEL_SCALE;
  out->gx = static_cast<int16_t>((data[8] << 8) | data[9]) / GYRO_SCALE;
  out->gy = static_cast<int16_t>((data[10] << 8) | data[11]) / GYRO_SCALE;
  out->gz = static_cast<int16_t>((data[12] << 8) | data[13]) / GYRO_SCALE;
  return true;
}

const char* SpellNameFromClassIndex(int class_index) {
  if (class_index < 0 || class_index >= g_preloaded_spell_count) {
    return "UNKNOWN";
  }
  return g_preloaded_spells[class_index].name.c_str();
}

// ---------------------------------------------------------------------------
// SAMPLING TASK: the only thing that determines real-world timing. Runs on
// a fixed period regardless of what the inference task is doing.
// ---------------------------------------------------------------------------
static void SamplingTask(void* /*arg*/) {
  TickType_t last_wake = xTaskGetTickCount();
  const TickType_t period_ticks = pdMS_TO_TICKS(STEM_SAMPLING_INTERVAL_MS);

  while (true) {
    ImuFrame frame{};
    if (ReadImuFrame(&frame)) {
      if (xSemaphoreTake(s_buffer_mutex, portMAX_DELAY) == pdTRUE) {
        memmove(s_shared_buffer, s_shared_buffer + CHANNELS,
                (BUFFER_LENGTH - CHANNELS) * sizeof(float));
        s_shared_buffer[BUFFER_LENGTH - 6] = frame.ax;
        s_shared_buffer[BUFFER_LENGTH - 5] = frame.ay;
        s_shared_buffer[BUFFER_LENGTH - 4] = frame.az;
        s_shared_buffer[BUFFER_LENGTH - 3] = frame.gx;
        s_shared_buffer[BUFFER_LENGTH - 2] = frame.gy;
        s_shared_buffer[BUFFER_LENGTH - 1] = frame.gz;
        s_shared_sample_count++;
        s_shared_version++;
        xSemaphoreGive(s_buffer_mutex);
      }
    }
    // vTaskDelayUntil keeps the period accurate even if ReadImuFrame() jitters
    // a little -- it targets absolute wake times, not relative sleeps.
    vTaskDelayUntil(&last_wake, period_ticks);
  }
}

// ---------------------------------------------------------------------------
// INFERENCE TASK: runs independently, always operating on the freshest
// available window snapshot. Contains the full gesture state machine that
// used to live in RunInference()/AppMainLoopStep().
// ---------------------------------------------------------------------------
static bool s_is_moving = false;
static float s_best_prob = 0.0f;
static int s_best_class = -1;
static float s_best_margin = -1.0f;
static float s_local_buffer[BUFFER_LENGTH] = {0};

__attribute__((weak)) void OnSpellDetected(int class_index) {
  (void)class_index;
}

static void InferenceTask(void* /*arg*/) {
  uint32_t last_seen_version = 0;

#if STEM_DEBUG_VERBOSE
  int64_t invoke_us_max = 0;
#endif

  while (true) {
    // Unconditional yield at the top of every iteration. Without this, when
    // new samples are always available faster than we can process them
    // (sampling every 20ms vs. Invoke() taking 45ms), this task never hits
    // the vTaskDelay() branch further down and runs back-to-back forever,
    // starving the Idle0 task and tripping the Task Watchdog (TWDT), which
    // monitors Idle tasks by default. A 1-tick delay is cheap relative to
    // Invoke()'s tens of milliseconds and guarantees Idle0 gets scheduled.
    vTaskDelay(1);

    uint32_t sample_count_snapshot = 0;
    uint32_t version_snapshot = 0;

    if (xSemaphoreTake(s_buffer_mutex, portMAX_DELAY) == pdTRUE) {
      memcpy(s_local_buffer, s_shared_buffer, sizeof(s_local_buffer));
      sample_count_snapshot = s_shared_sample_count;
      version_snapshot = s_shared_version;
      xSemaphoreGive(s_buffer_mutex);
    }

    // Skip if no new samples arrived since last time (avoids burning CPU
    // re-running inference on an identical window).
    if (version_snapshot == last_seen_version) {
      vTaskDelay(pdMS_TO_TICKS(STEM_INFERENCE_POLL_MS));
      continue;
    }
    last_seen_version = version_snapshot;

    if (sample_count_snapshot < WINDOW_SIZE) {
      vTaskDelay(pdMS_TO_TICKS(STEM_INFERENCE_POLL_MS));
      continue;
    }

    // ---- Tail-variance motion detection (unchanged logic, now operating on
    // a time-correct snapshot) ----
    const int TAIL_LEN = 15;
    int start_idx = WINDOW_SIZE - TAIL_LEN;

    float sum_ax = 0, sum_ay = 0, sum_az = 0, sum_gx = 0, sum_gy = 0, sum_gz = 0;
    for (int i = start_idx; i < WINDOW_SIZE; ++i) {
      sum_ax += s_local_buffer[i * CHANNELS + 0];
      sum_ay += s_local_buffer[i * CHANNELS + 1];
      sum_az += s_local_buffer[i * CHANNELS + 2];
      sum_gx += s_local_buffer[i * CHANNELS + 3];
      sum_gy += s_local_buffer[i * CHANNELS + 4];
      sum_gz += s_local_buffer[i * CHANNELS + 5];
    }
    float mean_ax = sum_ax / TAIL_LEN, mean_ay = sum_ay / TAIL_LEN, mean_az = sum_az / TAIL_LEN;
    float mean_gx = sum_gx / TAIL_LEN, mean_gy = sum_gy / TAIL_LEN, mean_gz = sum_gz / TAIL_LEN;

    float var_accel = 0, var_gyro = 0;
    for (int i = start_idx; i < WINDOW_SIZE; ++i) {
      float dx = s_local_buffer[i * CHANNELS + 0] - mean_ax;
      float dy = s_local_buffer[i * CHANNELS + 1] - mean_ay;
      float dz = s_local_buffer[i * CHANNELS + 2] - mean_az;
      var_accel += (dx * dx + dy * dy + dz * dz);
      float dgx = s_local_buffer[i * CHANNELS + 3] - mean_gx;
      float dgy = s_local_buffer[i * CHANNELS + 4] - mean_gy;
      float dgz = s_local_buffer[i * CHANNELS + 5] - mean_gz;
      var_gyro += (dgx * dgx + dgy * dgy + dgz * dgz);
    }
    var_accel /= TAIL_LEN;
    var_gyro /= TAIL_LEN;
    float motion_energy = var_accel + (var_gyro / 10000.0f);

#if STEM_DEBUG_VERBOSE
    {
      static int dbg_counter = 0;
      if (++dbg_counter >= 10) {
        dbg_counter = 0;
        ESP_LOGI(TAG,
                 "DEBUG_MOTION moving=%d energy=%.4f best_class=%d best_prob=%.2f",
                 s_is_moving, motion_energy, s_best_class, s_best_prob);
      }
    }
#endif

    if (s_is_moving) {
      if (motion_energy < 0.02f) {
        s_is_moving = false;
        int predicted_class = -1;
        if (s_best_class >= 0) {
          const char* name = SpellNameFromClassIndex(s_best_class);
          bool is_spell = (s_best_class < g_preloaded_spell_count)
                              ? g_preloaded_spells[s_best_class].is_spell
                              : true;
          if (!is_spell) {
#if STEM_DEBUG_VERBOSE
            printf("DEBUG_BLACKHOLE:%s (prob: %.2f)\n", name, s_best_prob);
#endif
          } else {
            printf("FINAL PREDICT:%s:%.2f\n", name, s_best_prob);
            predicted_class = s_best_class;
          }
        } else {
#if STEM_DEBUG_VERBOSE
          ESP_LOGW(TAG, "DEBUG_MOTION stop detected but best_class=-1 (no candidate ever accepted)");
#endif
        }

        s_best_prob = 0.0f;
        s_best_class = -1;
        s_best_margin = -1.0f;

        if (xSemaphoreTake(s_buffer_mutex, portMAX_DELAY) == pdTRUE) {
          for (int i = 0; i < WINDOW_SIZE; ++i) {
            s_shared_buffer[i * CHANNELS + 0] = s_local_buffer[BUFFER_LENGTH - 6];
            s_shared_buffer[i * CHANNELS + 1] = s_local_buffer[BUFFER_LENGTH - 5];
            s_shared_buffer[i * CHANNELS + 2] = s_local_buffer[BUFFER_LENGTH - 4];
            s_shared_buffer[i * CHANNELS + 3] = s_local_buffer[BUFFER_LENGTH - 3];
            s_shared_buffer[i * CHANNELS + 4] = s_local_buffer[BUFFER_LENGTH - 2];
            s_shared_buffer[i * CHANNELS + 5] = s_local_buffer[BUFFER_LENGTH - 1];
          }
          s_shared_version++;
          xSemaphoreGive(s_buffer_mutex);
        }

        if (predicted_class != -1) {
          OnSpellDetected(predicted_class);
        }
        continue;
      }
    } else {
      if (motion_energy > 0.10f) {
        s_is_moving = true;
#if STEM_DEBUG_VERBOSE
        ESP_LOGI(TAG, "DEBUG_MOTION start detected, energy=%.4f", motion_energy);
#endif
      } else {
        continue;
      }
    }

    // ---- Quantize + Invoke (unchanged) ----
    int model_frames = s_input->dims->data[1];
    int model_channels = s_input->dims->data[2];
    const float in_scale = s_input->params.scale;
    const float inv_scale = 1.0f / in_scale;
    const int in_zp = s_input->params.zero_point;
    int start_offset = BUFFER_LENGTH - (model_frames * 6);
    if (start_offset < 0) start_offset = 0;

    for (int f = 0; f < model_frames; ++f) {
      int idx = start_offset + f * 6;
      float ax = s_local_buffer[idx], ay = s_local_buffer[idx + 1], az = s_local_buffer[idx + 2];
      float gx = s_local_buffer[idx + 3], gy = s_local_buffer[idx + 4], gz = s_local_buffer[idx + 5];

      if (model_channels == 9) {
        float derived0 = az * gx;
        float derived1 = az * gy;
        float jerkz = (idx >= 6) ? (az - s_local_buffer[idx - 6 + 2]) : 0.0f;
        float in_vals[9] = {ax, ay, az, gx, gy, gz, derived0, derived1, jerkz};
        for (int c = 0; c < 9; c++) {
          int val = static_cast<int>(std::roundf(in_vals[c] * inv_scale)) + in_zp;
          val = val > 127 ? 127 : (val < -128 ? -128 : val);
          s_input->data.int8[f * 9 + c] = static_cast<int8_t>(val);
        }
      } else {
        float in_vals[6] = {ax, ay, az, gx, gy, gz};
        for (int c = 0; c < 6; c++) {
          int val = static_cast<int>(std::roundf(in_vals[c] * inv_scale)) + in_zp;
          val = val > 127 ? 127 : (val < -128 ? -128 : val);
          s_input->data.int8[f * 6 + c] = static_cast<int8_t>(val);
        }
      }
    }

#if STEM_DEBUG_VERBOSE
    int64_t t_invoke_start = esp_timer_get_time();
#endif

    if (s_interpreter->Invoke() != kTfLiteOk) {
      ESP_LOGE(TAG, "Invoke failed");
      continue;
    }

#if STEM_DEBUG_VERBOSE
    int64_t invoke_us = esp_timer_get_time() - t_invoke_start;
    if (invoke_us > invoke_us_max) invoke_us_max = invoke_us;
    {
      static int invoke_dbg_counter = 0;
      if (++invoke_dbg_counter >= 10) {
        invoke_dbg_counter = 0;
        ESP_LOGI(TAG, "DEBUG_TIMING invoke_us=%lld invoke_us_max=%lld (sampling period=%dms, decoupled)",
                 (long long)invoke_us, (long long)invoke_us_max, STEM_SAMPLING_INTERVAL_MS);
      }
    }
#endif

    const float out_scale = s_output->params.scale;
    const int out_zp = s_output->params.zero_point;
    float current_embedding[EMBEDDING_DIM];
    for (int i = 0; i < EMBEDDING_DIM; ++i) {
      current_embedding[i] = (s_output->data.int8[i] - out_zp) * out_scale;
    }
    float v_out[EMBEDDING_DIM];
    float norm_curr = 0.0f;
    for (int i = 0; i < EMBEDDING_DIM; ++i) {
      v_out[i] = current_embedding[i];
      norm_curr += v_out[i] * v_out[i];
    }
    float inv_norm = 1.0f / (std::sqrt(norm_curr) + 1e-6f);
    for (int i = 0; i < EMBEDDING_DIM; ++i) v_out[i] *= inv_norm;

    float max_cos = -1.0f;
    int max_idx = -1;
    for (int i = 0; i < g_preloaded_spell_count; ++i) {
      float cos_sim = 0.0f;
      for (int j = 0; j < EMBEDDING_DIM; ++j) {
        cos_sim += v_out[j] * g_preloaded_spells[i].centroid[j];
      }
      if (cos_sim > max_cos) {
        max_cos = cos_sim;
        max_idx = i;
      }
    }

#if STEM_DEBUG_VERBOSE
    {
      static int cls_dbg_counter = 0;
      if (++cls_dbg_counter >= 5) {
        cls_dbg_counter = 0;
        ESP_LOGI(TAG, "DEBUG_MOTION max_cos=%.3f max_idx=%d threshold=%.3f",
                 max_cos, max_idx,
                 max_idx >= 0 ? g_preloaded_spells[max_idx].threshold : -1.0f);
      }
    }
#endif

    if (max_idx >= 0 && max_cos >= g_preloaded_spells[max_idx].threshold) {
      if (max_cos > s_best_prob) {
        s_best_prob = max_cos;
        s_best_class = max_idx;
      }
    }
  }
}

bool InitializeSpellRuntime() {
  // Load gestures from NVS
  esp_err_t err = nvs_flash_init_partition("labels");
  if (err == ESP_ERR_NVS_NO_FREE_PAGES || err == ESP_ERR_NVS_NEW_VERSION_FOUND) {
      ESP_ERROR_CHECK(nvs_flash_erase_partition("labels"));
      err = nvs_flash_init_partition("labels");
  }
  if (err != ESP_OK) {
      ESP_LOGE(TAG, "Failed to init labels NVS partition");
      return false;
  }

  nvs_handle_t h;
  err = nvs_open_from_partition("labels", "cfg", NVS_READONLY, &h);
  if (err == ESP_OK) {
      uint8_t count = 0;
      err = nvs_get_u8(h, "count", &count);
      if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to read count from NVS: %s", esp_err_to_name(err));
        count = 0;
      }

      g_preloaded_spells.clear();
      g_preloaded_spells.reserve(count);

      for (int i = 0; i < count; i++) {
          PreloadedSpell spell;

          char name_key[16]; snprintf(name_key, sizeof(name_key), "g%d", i);
          char name_buf[32] = {0}; size_t name_len = sizeof(name_buf);
          err = nvs_get_str(h, name_key, name_buf, &name_len);
          if (err != ESP_OK) {
            ESP_LOGW(TAG, "Failed to read name for g%d: %s", i, esp_err_to_name(err));
            snprintf(name_buf, sizeof(name_buf), "unknown_%d", i);
          }
          name_buf[sizeof(name_buf)-1] = '\0';
          spell.name = name_buf;

          char cen_key[16]; snprintf(cen_key, sizeof(cen_key), "g%d_cen", i);
          size_t blob_size = 0;
          err = nvs_get_blob(h, cen_key, NULL, &blob_size);
          if (err != ESP_OK) {
            ESP_LOGW(TAG, "Failed to query blob size for g%d_cen: %s", i, esp_err_to_name(err));
            continue;
          }
          
          size_t expected_size = EMBEDDING_DIM * sizeof(float) + sizeof(float) + sizeof(uint8_t); // 64 + 4 + 1 = 69
          if (blob_size == expected_size) {
              std::vector<uint8_t> buf(blob_size);
              err = nvs_get_blob(h, cen_key, buf.data(), &blob_size);
              if (err != ESP_OK) {
                ESP_LOGE(TAG, "Failed to read blob for g%d_cen: %s", i, esp_err_to_name(err));
                continue;
              }
              
              spell.centroid.resize(EMBEDDING_DIM);
              memcpy(spell.centroid.data(), buf.data(), EMBEDDING_DIM * sizeof(float));
              memcpy(&spell.threshold, buf.data() + EMBEDDING_DIM * sizeof(float), sizeof(float));
              spell.is_spell = buf[EMBEDDING_DIM * sizeof(float) + sizeof(float)] != 0;
              g_preloaded_spells.push_back(std::move(spell));
          } else {
              ESP_LOGE(TAG, "Invalid blob size for gesture %d: %d (expected %d)", i, (int)blob_size, (int)expected_size);
          }
      }
      g_preloaded_spell_count = g_preloaded_spells.size();
      nvs_close(h);
      ESP_LOGI(TAG, "Loaded %d gestures from NVS", g_preloaded_spell_count);
  } else {
      ESP_LOGE(TAG, "Failed to open NVS namespace 'cfg': %s", esp_err_to_name(err));
      return false;
  }

  if (!InitI2cBus() || !InitMpu6050() || !InitInference()) {
    return false;
  }

  s_buffer_mutex = xSemaphoreCreateMutex();
  if (s_buffer_mutex == nullptr) {
    ESP_LOGE(TAG, "Failed to create buffer mutex");
    return false;
  }

  // Sampling task: small stack, high priority, must not be starved --
  // its timing accuracy is the whole point of this refactor.
  xTaskCreatePinnedToCore(SamplingTask, "imu_sampling", 4096, nullptr,
                           configMAX_PRIORITIES - 2, nullptr,
                           STEM_SAMPLING_TASK_CORE);

  // Inference task: larger stack (TFLM needs scratch space on its own
  // stack in addition to the tensor arena), lower priority than sampling.
  xTaskCreatePinnedToCore(InferenceTask, "gesture_inference", 8192, nullptr,
                           configMAX_PRIORITIES - 4, nullptr,
                           STEM_INFERENCE_TASK_CORE);

  return true;
}

}  // namespace spellbook

extern "C" void app_main(void) {
  if (!spellbook::InitializeSpellRuntime()) {
    ESP_LOGE("MAIN", "Runtime initialization failed - halting");
    while (true) { vTaskDelay(pdMS_TO_TICKS(1000)); }
  }
  ESP_LOGI("MAIN", "Sampling + inference tasks started (decoupled)");
  // app_main can return now -- both tasks keep running independently.
}