  "narrative": {
    "northStar": "The Guided Studio",
    "overview": "The Guided Studio là phòng thí nghiệm ánh sáng trắng trên bàn học ký túc — mọi thao tác đều có trình tự 0→7, mỗi màn hình chỉ hỏi một việc và chỉ đường cho việc kế tiếp. Hệ thống từ chối Đồ chơi lòe loẹt, Dashboard ERP lạnh lẽo, và SaaS landing hero-metric. Thay vào đó là Restrained với một accent duy nhất, tonal layering thay shadow, và progress disclosure.",
    "keyCharacteristics": [
      "Dẫn dắt thầm lặng: Tab 0→7 là lộ trình",
      "Số liệu kèm câu chuyện: mọi metric có một dòng note_box",
      "Nhất quán tuyệt đối: cùng card, cùng gap, cùng cỡ chữ",
      "Rỗng là cơ hội dạy: empty state nói cách sửa"
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Trên bất kỳ màn hình nào, chỉ #0668d1 được coi là tín hiệu hành động/chọn. Success/Warning/Danger không dùng cho trang trí.",
        "section": "colors"
      },
      {
        "name": "The Tonal Layering Rule",
        "body": "Chiều sâu đến từ BG_APP → SURFACE → SUNK, không phải blur. Shadow chỉ khi hover.",
        "section": "colors"
      },
      {
        "name": "The Single Family Rule",
        "body": "Một Segoe UI stack gánh heading, button, label, data.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surface phẳng khi nghỉ; shadow chỉ xuất hiện như phản hồi hover/focus.",
        "section": "elevation"
      },
      {
        "name": "The No-Hard-Coded-Light Rule",
        "body": "QSS dùng chung hai theme cấm hex light; mọi màu text/focus/disabled đi qua token theme.",
        "section": "colors"
      },
      {
        "name": "The 11px Floor Rule",
        "body": "Không có chữ nào dưới 11px — kể cả badge, HUD tag, progress text.",
        "section": "typography"
      },
      {
        "name": "The Chart Title Rule",
        "body": "section_label() chỉ cho legend nhóm trường; tiêu đề biểu đồ dùng chart_title() INK không caps.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do dùng lab_style token duy nhất — không hard-code #0668d1 lẻ.",
      "Do giữ TAB_BAR 8 tabs ngang hàng (0 · Chọn thần chú là entry).",
      "Do dùng note_box(hue) cho mọi giải thích sư phạm.",
      "Do để empty state dạy: Chưa có thần chú nào. Hãy ghi thần chú đầu tiên ở trang Ghi dữ liệu.",
      "Do tonal layering BG_APP → SURFACE → SUNK trước khi nghĩ đến shadow."
    ],
    "donts": [
      "Don't làm Đồ chơi lòe loẹt — không emoji dày, không gradient.",
      "Don't làm Dashboard ERP lạnh lẽo — không bảng số không giải thích.",
      "Don't dùng SaaS hero-metric + eyebrow uppercase trên mọi section.",
      "Don't border 1px + box-shadow 16px ghost-card.",
      "Don't border-radius 32px+ trên card.",
      "Don't nest card trong card.",
      "Don't dùng repeating-linear-gradient stripe.",
      "Don't dùng ACCENT cho success/warning.",
      "Don't ghép alpha vào hex ({color}1F) — Qt parse #AARRGGBB alpha-trước, ra màu sai. Dùng rgba() qua _tint().",
      "Don't tô text bằng màu spell người dùng chọn mà không guard contrast_ratio >= 3:1 so với surface.",
      "Don't font dưới 11px.",
      "Don't hard-code hex light trong QSS dùng chung hai theme."
    ]
  }
